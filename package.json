{
  "name": "a3lam-phase02",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "test": "vitest run",
    "test:integration": "pnpm db:migrate && pnpm db:seed && vitest run --config vitest.integration.config.ts",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:seed": "A3LAM_ALLOW_SYNTHETIC_SEED=true node scripts/db-seed.mjs",
    "test:watch": "vitest",
    "format": "prettier --check ."
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "next": "16.3.1",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "prettier": "3.9.6",
    "typescript": "6.0.2",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@11.21.0"
}
