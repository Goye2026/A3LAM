# Copy this file to .env.local for development. Never commit real secrets.
# Production deployments must provide their own values through secret storage.

# Runtime environment: use development locally and production on the hosting platform.
NODE_ENV=development
LOG_LEVEL=info

# Server-only PostgreSQL connection string.
# Development example only; replace with the managed PostgreSQL URL in production.
DATABASE_URL=postgres://a3lam:a3lam@localhost:5432/a3lam
DATABASE_MAX_CONNECTIONS=5

# Public origin used for canonical URLs, sitemap, Open Graph, and JSON-LD.
# Keep localhost for local development; set the real HTTPS origin in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Synthetic seed is opt-in only and development-only.
# Do not set this to true in production. The seed script rejects NODE_ENV=production.
# A3LAM_ALLOW_SYNTHETIC_SEED=true
