# A3LAM environment template
# This file contains names and placeholders only. Never commit real credentials.

# -----------------------------
# Required runtime variables
# -----------------------------
NODE_ENV=production
LOG_LEVEL=info
PORT=3000
HOSTNAME=0.0.0.0

# Server-only PostgreSQL connection string.
# URL-encode reserved characters in USER/PASSWORD when constructing the value.
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME
DATABASE_MAX_CONNECTIONS=5

# Public HTTPS origin used for canonical URLs, sitemap, Open Graph, and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Server-only Admin CMS secret. Generate and store it in a secret manager.
# Minimum length enforced by the application: 32 characters.
A3LAM_ADMIN_ACCESS_TOKEN=replace-with-a-random-32-plus-character-secret

# Optional signed Admin session lifetime; default 8 hours, maximum 7 days.
A3LAM_ADMIN_SESSION_TTL_SECONDS=28800

# -----------------------------
# Optional/provider-specific variables
# -----------------------------
# External object storage. If any value is missing, uploads remain safely unavailable.
A3LAM_STORAGE_UPLOAD_URL=https://storage.example/upload
A3LAM_STORAGE_PUBLIC_BASE_URL=https://cdn.example/a3lam
A3LAM_STORAGE_UPLOAD_TOKEN=replace-with-storage-provider-token

# Synthetic seed is development-only and forbidden for Production.
A3LAM_ALLOW_SYNTHETIC_SEED=false

# -----------------------------
# Docker Compose-only variables
# -----------------------------
POSTGRES_DB=a3lam
POSTGRES_USER=a3lam_app
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
APP_PORT=3000

# -----------------------------
# Local-only example guidance
# -----------------------------
# For local development, use a separate untracked .env.local file and a local
# PostgreSQL URL. Do not copy local passwords into this template or into Git.
